# Database — defaults to SQLite for zero-config local dev.
# For production: postgresql+asyncpg://user:pass@host:5432/agentlens
DATABASE_URL=sqlite+aiosqlite:///./agentlens.db

CORS_ORIGINS=["http://localhost:3000"]

WORKSPACE_DIR=/tmp/agentlens-workspaces
MAX_REPO_SIZE_MB=250
MAX_FILES_SCANNED=5000

# Paritok — leave PARITOK_API_KEY empty to use the local compression
# fallback engine (still produces real, computed before/after numbers).
PARITOK_API_BASE_URL=https://api.paritok.dev
PARITOK_API_KEY=

# Optional — reserved for the AI Optimization Chat feature
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
